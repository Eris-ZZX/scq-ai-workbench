{
  "name": "quality-workbench-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint app components db lib scripts tests instrumentation.ts instrumentation-node.ts proxy.ts next.config.ts drizzle.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",

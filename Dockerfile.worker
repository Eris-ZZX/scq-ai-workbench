# DWS Worker runtime. The dws CLI (DingTalk Workspace CLI, official open-source
# from DingTalk: DingTalk-Real-AI/dingtalk-workspace-cli) is installed here from
# its official install.sh. Login state lives in the mounted DWS_CONFIG_DIR
# volume (see docker-compose.yml: HOME=/run/dws + DWS_DISABLE_KEYCHAIN=1).
FROM node:22-bookworm-slim

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.6.0 --activate

# Install the official dws CLI.
#   DWS_INSTALL_DIR=/usr/local/bin — put the binary on PATH
#   DWS_NO_SKILLS=1                — the worker only needs the CLI, not Agent skills
#   install.sh auto-falls back to the Gitee mirror when GitHub is unreachable
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL https://raw.githubusercontent.com/DingTalk-Real-AI/dingtalk-workspace-cli/main/scripts/install.sh \
       | DWS_INSTALL_DIR=/usr/local/bin DWS_NO_SKILLS=1 sh \
    && dws version \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .

ENV NODE_ENV=production
CMD ["pnpm", "dws:worker"]

DATABASE_URL=postgresql://qe:change-me@127.0.0.1:5432/qe
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000
ADMIN_INITIAL_PASSWORD=replace-on-first-empty-database-start

# Authing OIDC (required in production)
AUTHING_ISSUER=
AUTHING_CLIENT_ID=
AUTHING_CLIENT_SECRET=

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=qe-workbench

# DWS CLI belongs only on the separate Worker/operations host.
# Do not copy DWS login state or credentials into the Web container.
DWS_CONFIG_DIR=
DWS_DISABLE_KEYCHAIN=1
DWS_CLI_COMMAND=dws
DWS_CLI_TIMEOUT_MS=30000
DWS_WORKER_ID=
DWS_WORKER_INTERVAL_MS=5000
DWS_MAX_ATTEMPTS=5
# one-shot smoke mode for a controlled Worker host
DWS_WORKER_ONCE=false

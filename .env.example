DATABASE_URL=postgresql://qe:change-me@127.0.0.1:5432/qe
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000
ADMIN_INITIAL_PASSWORD=replace-on-first-empty-database-start

# Authing OIDC (required in production)
AUTHING_ISSUER=
AUTHING_CLIENT_ID=
AUTHING_CLIENT_SECRET=

# SQM 独立图纸可靠性应用 SSO migration fallback.
# 首次部署后优先在「平台后台管理 → 外挂应用连接」中配置。
# HTTP、HTTPS 均可；生产环境建议使用 HTTPS。
SQM_DRAWING_RELIABILITY_URL=http://127.0.0.1:8001
SQM_LAUNCH_EXCHANGE_SECRET=replace-with-a-dedicated-random-secret

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=qe-workbench

# DingTalk app credentials (work notifications and todos)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=
DINGTALK_AGENT_ID=
